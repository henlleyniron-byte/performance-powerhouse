{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/performance-powerhouse/practical-lab-catalog-v3.schema.json",
  "title": "Performance Powerhouse Practical Lab - Public educational catalog V3",
  "type": "object",
  "required": ["schema_version", "release", "counts", "activities", "source_handbooks", "official_publisher"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release": {"type": "string"},
    "release_label": {"type": "string"},
    "official_publisher": {"const": false},
    "counts": {
      "type": "object",
      "properties": {"biology": {"const": 38}, "chemistry": {"const": 45}, "physics": {"const": 43}, "total": {"const": 126}},
      "required": ["biology", "chemistry", "physics", "total"]
    },
    "source_handbooks": {"type":"object","required":["biology","chemistry","physics"]},
    "activities": {
      "type": "array", "minItems": 126,"maxItems":126,
      "items": {
        "type": "object",
        "required": ["id","subject","nie_number","title","nie_print_page","handbook_url","principle","record_guidance","analysis_guidance","common_error","recall_question","recall_answer","observation_columns","review_status"],
        "properties": {
          "id": {"type":"string", "pattern":"^(bio|che|phy)-(?:[0-9]{3}|[0-9]{1,2}-[0-9])$"},
          "subject": {"enum":["biology","chemistry","physics"]},
          "nie_number": {"type":"string", "minLength":1},
          "title": {"type":"string", "minLength":5},
          "nie_print_page": {"type":"integer","minimum":1},
          "handbook_url": {"type":"string", "format":"uri"},
          "principle": {"type":"string", "minLength":15},
          "record_guidance": {"type":"string", "minLength":15},
          "analysis_guidance": {"type":"string", "minLength":15},
          "common_error": {"type":"string", "minLength":15},
          "recall_question": {"type":"string", "minLength":8},
          "recall_answer": {"type":"string", "minLength":2},
          "observation_columns": {"type":"array", "minItems":4, "maxItems":4, "items":{"type":"string"}},
          "review_status": {"const":"independently_prepared_not_teacher_verified"},
          "lab_procedure_included": {"const":false}
        }
      }
    }
  }
}
